APP_URL=http://localhost:4173
# Comma-separated browser origins allowed to submit authenticated mutations.
# Production: https://tova.com.ng,https://www.tova.com.ng
ALLOWED_ORIGINS=http://localhost:4173
# Set DATABASE_URL in production to use Render PostgreSQL. Leave it empty locally to use SQLite.
DATABASE_URL=
DATABASE_PATH=./data/tova.local.db
MAIL_TRANSPORT=local
PAYOUT_MINIMUM_MINOR=5000000
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_API_URL=https://api.mailgun.net
# Dedicated affiliate administration credentials. Keep these server-only.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# 32-byte hex or base64 key used to encrypt payout details at rest.
PAYOUT_ENCRYPTION_KEY=
# Shared secret for product apps posting signup and subscription events.
INTEGRATION_API_KEY=
# JSON object for separate product secrets, e.g. {"tovabooks":"...","tovapos":"...","tovafixedasset":"..."}
INTEGRATION_KEYS_JSON=
# Comma-separated product allowlist. Required in production.
INTEGRATION_PRODUCTS=
